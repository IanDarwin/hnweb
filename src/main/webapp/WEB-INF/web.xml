<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	id="WebApp_ID" version="3.0">

	<display-name>Club Members Database</display-name>

	<welcome-file-list>
		<welcome-file>index.web</welcome-file>
	</welcome-file-list>

	<!-- Login filter -->
	<filter>
		<filter-name>login</filter-name>
		<filter-class>webtier.LoginFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>login</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- Page View filter -->
	<filter>
		<filter-name>pageview</filter-name>
		<filter-class>webtier.PageViewFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>pageview</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- JSF Servlet -->
	<servlet>
		<servlet-name>Faces Servlet</servlet-name>
		<servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>Faces Servlet</servlet-name>
		<url-pattern>*.web</url-pattern>
	</servlet-mapping>

	<!-- Mime-mappings, needed by buggy Wildfly 8 -->
	<mime-mapping>
		<extension>jsp</extension>
		<mime-type>text/html</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>web</extension>
		<mime-type>text/html</mime-type>
	</mime-mapping>
	
	<!-- error pages -->
	<error-page>
		<error-code>404</error-code>
		<location>/errors/404.jsp</location>
	</error-page>
	<error-page>
    	<exception-type>javax.faces.application.ViewExpiredException</exception-type>
    	<location>/errors/viewExpired.jsp</location>
	</error-page>
	<error-page>
    	<error-code>500</error-code>
    	<location>/errors/500.jsp</location>
</error-page>

</web-app>
