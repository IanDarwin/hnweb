#!/bin/sh

# memberlist - print a hardcopy listing. Pipe into print-memberlist to actually print.

# XXX Convert to Java, option to include only current member year
# fold secondaries into main, strip lastname if same

psql -d hn -c 'select id,firstname,lastname,membertype,email,expiryyear from member order by lower(lastname);' |
		tr -s ' ' |
			awk -F'|' '$1>0{printf "%-4d %23s %-16s %-14s %-34s %4s\n", $1, $2, $3, $4, $5, $6}'
