#!/bin/sh

# memberlist - print a hardcopy listing. Print with print-memberlist (which calls this script).

# XXX Convert to Java or Python, option to include only current member year
# fold secondaries into main, strip lastname if same

psql -d hn -c 'select id,firstname,lastname,membertype,email,expiryyear from member order by lower(lastname);' |
		tr -s ' ' |
			awk -F'|' '$1>0{printf "%4d %25s %-17s %-14s %-36s %4s\n", $1, $2, $3, $4, $5, $6}'
