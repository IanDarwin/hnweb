#!/bin/sh

USAGE="Usage: $0 firstname lastname email"

MAIL_TYPE="MailOnly"

# Add a person to the mailing list - firstname lastname email
case $# in
	3) psql -d hn -c "insert into member(firstname,lastname,email,membertype) values('$1','$2','$3','$MAIL_TYPE');" ;;
	*) echo "$USAGE" >&2; exit 1;;
esac
