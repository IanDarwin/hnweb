#!/bin/ksh

# renew member by id

if [ $# != 3 ]; then
	echo Usage: "$0 id ca|ch|et|pl amt"
	exit 1
fi

id=$1
PTYPE=$2
AMT=$3

DYEAR=$(date +%Y)
MONTH=$(date +%m)
YEAR=$((MONTH<6?DYEAR:DYEAR+1))
echo "Today's date $DYEAR-$MONTH Renewal year $YEAR"

case $# in 
0) echo usage: $0 idNum ...
exit 1
;;
esac

 psql -d hn -c "UPDATE member SET expiryyear = $YEAR WHERE id = $id;
				SELECT id,firstname,lastname,expiryyear FROM member WHERE id = $id";

echo "Creating financial tx"
psql -d hn -c "INSERT INTO transaction(member_id,newexpiryyear,paymenttype,reason,amount)
				values($id, $YEAR, '"$PTYPE"', 'r', $AMT)"

email=$(psql -d hn -c "SELECT email FROM member WHERE id = $id;" | grep @)
echo Sending thanks to $email
echo "Thank you for your membership renewal for the $YEAR membership year.

--Ian Darwin
Membership Chair
ian@darwinsys.com
" | Mail -s "[hn] Thank you for renewing!" -r "no-reply@hn.darwinsys.com" $email
