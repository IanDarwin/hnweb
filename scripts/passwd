#!/bin/sh

# update a member's password, until we get this working in the webapp


case $# in
	2)	;;
	*)	echo "Usage: $0 newPasswd memberEmail" >&2
		exit 1;
		;;
esac

NEWPASS=$1
MEMBER_EMAIL=$2

echo "update member set password = '$(echo -n $NEWPASS | md5)' where member.email = '${MEMBER_EMAIL}';" |
	psql -d ucfn
