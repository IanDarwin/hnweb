#!/bin/sh

# update a member's password, e.g., for testing.

case $# in
	2)	;;
	*)	echo "Usage: $0 memberEmail newPasswdClear" >&2
		exit 1;
		;;
esac

MEMBER_EMAIL=$1
NEWPASS=$2

if [ ${NEWPASS} == "-r" ]; then
	NEWPASS=$(genpwd)
	echo Password is ${NEWPASS}
fi

HASH=$(/bin/echo -n ${NEWPASS} | md5)

echo "update member set password = '${HASH}' where member.email = '${MEMBER_EMAIL}';" |
	psql -d hn
