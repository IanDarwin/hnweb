#!/bin/ksh

# renew member by id

function usage {
	echo "Usage: id ca|ch|et|pl amt" >&2
	exit 1
}

if [[ $(hostname) != darwinsys.com ]]; then
	echo "$0: Only on the one true machine!" >&2
	usage
fi

SOYLENT=false
# -s is for silent, eg. no email
# usually when it's long delayed :-)
if [ $1 = "-s" ]; then
	SOYLENT=true
	shift
fi

if [ $# != 3 ]; then
	usage
fi

id=$1
PTYPE=$2
AMT=$3

case $PTYPE in
	ca|ch|et|pl);;
	*) echo "$0: $PTYPE looks half-baked!" >&2
		usage
		;;
esac

case $AMT in
	[0-9][0-9]);;
	*) echo "$0: $AMT looks fishy" >&2
		usage
		;;
esac

DYEAR=$(date +%Y)
MONTH=$(date +%m)
YEAR=$((MONTH<6?DYEAR:DYEAR+1))
echo "Today's date $DYEAR-$MONTH Renewal year $YEAR"

case $# in 
0) echo usage: $0 idNum ...
exit 1
;;
esac

 psql -d hn -c "UPDATE member SET expiryyear = $YEAR WHERE id = $id;
				SELECT id,firstname,lastname,expiryyear FROM member WHERE id = $id";

echo "Creating financial tx"
psql -d hn -c "INSERT INTO transaction(member_id,newexpiryyear,paymenttype,reason,amount)
				values($id, $YEAR, '"$PTYPE"', 'r', $AMT)"

echo "Verifying update:"
psql -d hn -c "SELECT firstname,lastname,email,expiryyear FROM member WHERE id = $id;"

if [ true != $SOYLENT ]; then

email=$(psql -d hn -c "SELECT email FROM member WHERE id = $id;" | grep @)
	echo Sending thanks to $email
	echo "Thank you for your membership renewal for the $YEAR membership year.
Your renewal has now been posted into our membership database.

--Ian Darwin
Membership Chair
ian@darwinsys.com
	" | Mail -s "[hn] Thank you for renewing!" -r "no-reply@hn.darwinsys.com" $email

fi
