#!/bin/sh

# remove a member after copying into member_archived

if [ $# != 1 ];then
	echo usage: $0 id
	exit
fi

ID=$1

echo "Creating member_archived subset"
psql -d hn -c "insert into member_archived select id,firstname,lastname,email,cellphone,homephone,workphone,yearjoined,expiryyear,created,lastmodified from member where id = ${ID};"

echo "Deleting any transactions for member"
psql -d hn -c "delete from transaction where member_id = ${ID};"

echo "Now the real deal..."
psql -d hn -c "delete from member cascade where id = ${ID};"

echo "Checking if member still exists (should be no rows!)"
psql -d hn -c "select * from member where id = ${ID};"

echo "Checking member_archived entry."
psql -d hn -c "select * from member_archived where id = ${ID};"

