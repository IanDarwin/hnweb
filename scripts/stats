#!/bin/sh

. ./CURYEAR

psql -d hn <<!

\echo #1 Counting total entries (including unpaid newbies and hangers-on)

select count(id) from member;

\echo #2 Counting just Individual paid-up memberships

select count(id) from member where membertype = 'Individual' AND expiryyear >= ${CURYEAR};

\echo #3 Counting Family (master) paid-up memberships for ${CURYEAR}
 
select count(id) from member where membertype = 'Family' and expiryyear >= ${CURYEAR};

!
