#!/bin/sh

YEAR=$(date +%Y)

psql -d ucfn <<!

\echo #1 Counting total member entries (including family members)

select count(id) from member;

\echo #2 Counting just Individual and Family (master) memberships

select count(id) from member where membertype != 'Secondary';

\echo #3 Counting Individual and Family (master) memberships that ARE PAID for ${YEAR}
 
select count(id) from member where membertype != 'Secondary' and expiryyear >= ${YEAR};

\echo #4 Counting financial transactions (should equal #2)

select count(id) from transaction;

!
