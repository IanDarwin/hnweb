#!/bin/sh

. ./CURYEAR

echo "Headwaters Nature: Stats for membership year ${CURYEAR}"

cat >/tmp/st <<!

\echo #1 Counting total entries (includes indivs, family members, unpaid newbies, hangers-on, &c)

SELECT COUNT(id) FROM member;

\echo #2 Counting total PAID memberships of all types

select count(id) from member where membertype in ('Individual','Family') and expiryyear >= ${CURYEAR};

\echo #3a Counting only Individual paid-up memberships

SELECT COUNT(id) FROM member WHERE membertype = 'Individual' AND expiryyear >= ${CURYEAR};

\echo #3b Counting only Family (master) paid-up memberships for ${CURYEAR}
 
SELECT COUNT(id) FROM member WHERE membertype = 'Family' and expiryyear >= ${CURYEAR};

-- \echo #4 COUNTing Secondary Family memberships for ${CURYEAR}
-- Sometimes SQL is a bit much...
-- SELECT COUNT(id) FROM member m WHERE m.membertype = 'Secondary' and
-- 	(SELECT ma FROM member WHERE id = m.mastermember_id AND ma.expiryyear >= ${CURYEAR});
!
psql -d hn < /tmp/st | rg -v '(rows?\))|^ count'
